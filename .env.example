# ============================================================
#  MDA — ตัวอย่างไฟล์ตั้งค่าความลับ
#
#  วิธีใช้
#    1) คัดลอกไฟล์นี้เป็น  .env   (ชื่อไฟล์ต้องเป็น .env เท่านั้น)
#    2) ใส่คีย์ของคุณต่อท้ายเครื่องหมาย = โดยไม่ต้องมีเครื่องหมายคำพูด
#    3) รันเซิร์ฟเวอร์ใหม่:  python server.py
#
#  ไฟล์ .env ถูก .gitignore ไว้แล้ว จึงไม่ถูก commit ขึ้น git
#  ห้ามใส่คีย์ลงในไฟล์ .env.example นี้ (ไฟล์นี้ถูก commit ขึ้น git)
# ============================================================

# คีย์ Anthropic — ขอได้ที่ https://console.anthropic.com/settings/keys
# ถ้าไม่ใส่ ระบบยังทำงานได้ แต่จะใช้ Google Translate + วิเคราะห์โหมด offline แทน
ANTHROPIC_API_KEY=

# คีย์ AISStream (ฟรี) — ขอได้ที่ https://aisstream.io/authenticate
# ใช้รับตำแหน่งเรือจริงแบบเรียลไทม์ หมุดบนแผนที่จะขยับตามเรือที่แล่นอยู่จริง
# ถ้าไม่ใส่ แผนที่จะใช้หมุดที่สกัดจากข่าวแทน (ตำแหน่งโดยประมาณตามภูมิภาค)
AISSTREAM_API_KEY=
